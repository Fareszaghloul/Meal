# Copy this file to .env and fill in your values

# Prisma Postgres (pooled URL + direct URL)
DATABASE_URL="postgres://..."
PRISMA_DATABASE_URL="postgres://..."
# Dedicated PostgreSQL database for automated tests (must NOT point to persistent DB)
TEST_DATABASE_URL="postgres://.../meal_test?sslmode=require"

# Public base URL of the app (no trailing slash); used to mark the session cookie Secure over https
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# External food databases
# Open Food Facts: public REST API, no credentials required
OPEN_FOOD_FACTS_ENABLED="true"
# USDA FoodData Central: free key at https://fdc.nal.usda.gov/api-guide.html (DEMO_KEY is heavily rate limited)
USDA_ENABLED="true"
USDA_API_KEY="DEMO_KEY"
# FatSecret (optional; disabled unless both credentials are set)
FATSECRET_ENABLED="false"
FATSECRET_CLIENT_ID=""
FATSECRET_CLIENT_SECRET=""

# Optional: Ollama server for recipe parsing (+ Cloudflare Access headers if tunnelled)
OLLAMA_BASE_URL="http://localhost:11434"
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""
